# Cloudflare Turnstile (captcha). Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
# Leave BOTH empty to run with Cloudflare's always-pass test keys (local development only).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Storage. On Vercel, add "Upstash for Redis" from the Marketplace and these are injected for you.
# Either pair works. Without them, scenarios are kept in memory (lost on restart).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: email private edit links through Resend (domain sail.mopamo.dev verified there).
resend_secret=
# EMAIL_FROM=Sail Scenario Workshop <noreply@sail.mopamo.dev>
# SITE_URL=https://sail.mopamo.dev

# Optional: enables DELETE /api/scenarios/:id for moderation (Authorization: Bearer <token>). Min. 16 characters.
ADMIN_TOKEN=
